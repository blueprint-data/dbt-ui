{
  "name": "dbt-ui",
  "author": "Juan Pablo Rivero",
  "repository": {
    "type": "git",
    "url": "https://github.com/blueprint-data/dbt-ui.git"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/*/*"
  ],
  "scripts": {
    "setup:wasm": "node -e \"const fs=require('fs'),path=require('path');const src=path.join(__dirname,'node_modules/.pnpm');const dirs=fs.readdirSync(src).filter(d=>d.startsWith('sql.js@'));if(dirs[0]){const wasm=path.join(src,dirs[0],'node_modules/sql.js/dist/sql-wasm.wasm');const dest=path.join(__dirname,'apps/web/dbt-docs-redesign/public/sql-wasm.wasm');fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(wasm,dest);console.log('✅ WASM file copied to apps/web/dbt-docs-redesign/public/');}\"",
    "verify": "node verify-setup.js",
    "dev": "cd apps/web/dbt-docs-redesign && npm run dev",
    "dev:take": "bash ./scripts/dev-take.sh",
    "build": "cd apps/web/dbt-docs-redesign && npm run build",
    "build:standalone": "cd apps/web/dbt-docs-redesign && npm run build:standalone",
    "build:npm": "./scripts/build-npm.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch@<2.3.2": "^2.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "postcss@<8.5.23": "^8.5.23",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "@babel/core@<7.29.6": "^7.29.6",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2"
    }
  }
}